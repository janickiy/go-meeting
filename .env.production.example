# Пример, не готовый production env. Каждый secret генерируется независимо.
APP_ENV=production
GIN_MODE=release
APP_PORT=8085
JWT_SECRET=
MEDIA_TICKET_SECRET=
MEDIA_INTERNAL_SECRET=
WORKER_INTERNAL_SECRET=
METRICS_SECRET=
TURN_SHARED_SECRET=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=go_recorder
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable
REDIS_HOST=redis
REDIS_PASSWORD=
RABBIT_MQ_HOST=rabbitmq
RABBIT_MQ_USER=
RABBIT_MQ_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=recordings
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=https://meet.example.invalid
WORKER_INTERNAL_URL=http://worker:8090
MEDIA_WORKER_INTERNAL_URL=http://media-worker:8091
MEDIA_WORKER_ID=media-production-1
WORKER_ID=recorder-production-1
# Реальные hostname/public IPv4 вместо example.invalid и пустых значений.
WS_ALLOWED_ORIGINS=https://meet.example.invalid
HTTP_TRUSTED_PROXIES=
MEDIA_NAT_IPS=
MEDIA_UDP_PORT=50010
MEDIA_TCP_PORT=50010
MEDIA_UDP_MIN_PORT=0
MEDIA_UDP_MAX_PORT=0
MEDIA_MAX_ROOMS=20
MEDIA_MAX_PEERS=10
MEDIA_MAX_PUBLISHED_TRACKS=4
MEDIA_MAX_AUDIO_TRACKS=2
MEDIA_MAX_VIDEO_TRACKS=2
MEDIA_EGRESS_QUEUE_SIZE=512
WEBRTC_ICE_SERVERS_JSON=[]
TURN_URLS=turn:turn.example.invalid:3478?transport=udp,turn:turn.example.invalid:3478?transport=tcp,turns:turn.example.invalid:5349?transport=tcp
TURN_PUBLIC_IP=
TURN_REALM=turn.example.invalid
TURN_MIN_PORT=49160
TURN_MAX_PORT=49259
TURN_CREDENTIAL_TTL=10m
TURN_FORCE_RELAY=false
RATE_LIMIT_ENABLED=true
STORAGE_PATH=/storage
RECORDER_STORAGE_DIR=
TLS_CERT_DIR=
TURN_TLS_CERT_DIR=
WS_MAX_CONNECTIONS=1000
HTTP_MAX_BODY_BYTES=1048576
HTTP_READ_TIMEOUT=60s
DB_MAX_OPEN=20
DB_MAX_IDLE=10
DB_CONNECTION_LIFETIME=30m
DB_QUERY_TIMEOUT=10s
HEALTH_PROBE_INTERVAL=2s
HEALTH_PROBE_TIMEOUT=1s
SHUTDOWN_TIMEOUT=20s
PPROF_PORT=0
RECORDING_MAX_ACTIVE=2
RECORDING_FFMPEG_CONCURRENCY=1
RECORDING_MAX_DURATION=4h
RECORDING_MAX_MIB=10240
RECORDING_DISK_RESERVE_MIB=1024
RECORDING_KEEP_LOCAL=false
