#!/bin/sh
# Sourced by the official Nginx entrypoint before envsubst renders the config.
# Every injected CSP source is an exact operator-configured origin, never Host.

csp_invalid_origin() {
    echo "Invalid frontend CSP origin configuration" >&2
    exit 1
}

csp_valid_hostport() {
    printf '%s' "$1" | grep -Eq '^([A-Za-z0-9][A-Za-z0-9.-]*|\[[0-9A-Fa-f:.]+\])(:[0-9]{1,5})?$'
}

public_origin=${PUBLIC_FRONTEND_URL:-http://localhost:5173}
case "$public_origin" in
    https://*) public_host=${public_origin#https://}; csp_ws_origin="wss://$public_host" ;;
    http://*)
        [ "${APP_ENV:-local}" != production ] || csp_invalid_origin
        public_host=${public_origin#http://}
        csp_ws_origin="ws://$public_host"
        ;;
    *) csp_invalid_origin ;;
esac
csp_valid_hostport "$public_host" || csp_invalid_origin

csp_valid_extra_ws() {
    [ -z "$1" ] && return 0
    case "$1" in
        wss://*) csp_extra_host=${1#wss://} ;;
        ws://*)
            [ "${APP_ENV:-local}" != production ] || csp_invalid_origin
            csp_extra_host=${1#ws://}
            ;;
        *) csp_invalid_origin ;;
    esac
    csp_valid_hostport "$csp_extra_host" || csp_invalid_origin
}

csp_extra_ws_origin=${CSP_EXTRA_WS_ORIGIN:-}
csp_extra_ws_origin_2=${CSP_EXTRA_WS_ORIGIN_2:-}
csp_valid_extra_ws "$csp_extra_ws_origin"
csp_valid_extra_ws "$csp_extra_ws_origin_2"

csp_storage_origin=
storage_endpoint=${MINIO_PUBLIC_ENDPOINT:-}
case "$storage_endpoint" in
    "") ;;
    https://*)
        storage_host=${storage_endpoint#https://}
        csp_valid_hostport "$storage_host" || csp_invalid_origin
        csp_storage_origin="https://$storage_host"
        ;;
    http://*)
        [ "${APP_ENV:-local}" != production ] || csp_invalid_origin
        storage_host=${storage_endpoint#http://}
        csp_valid_hostport "$storage_host" || csp_invalid_origin
        # Local development can play presigned MinIO media on its loopback port.
        case "$storage_host" in
            localhost|localhost:*|127.0.0.1|127.0.0.1:*) ;;
            *) csp_invalid_origin ;;
        esac
        csp_storage_origin="http://$storage_host"
        ;;
    *) csp_invalid_origin ;;
esac

export CSP_WS_ORIGIN="$csp_ws_origin"
export CSP_EXTRA_WS_ORIGIN="$csp_extra_ws_origin"
export CSP_EXTRA_WS_ORIGIN_2="$csp_extra_ws_origin_2"
export CSP_STORAGE_ORIGIN="$csp_storage_origin"
