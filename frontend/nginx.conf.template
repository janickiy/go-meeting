map $http_upgrade $connection_upgrade { default upgrade; '' close; }
log_format safe_realtime '$remote_addr $request_method $uri $status';
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 1m;
    access_log /var/log/nginx/access.log safe_realtime;

    # Docker DNS заново разрешает адрес API после пересоздания его контейнера.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream "${API_UPSTREAM}";
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: ${CSP_STORAGE_ORIGIN}; media-src 'self' blob: ${CSP_STORAGE_ORIGIN}; font-src 'self'; connect-src 'self' ${CSP_WS_ORIGIN} ${CSP_EXTRA_WS_ORIGIN} ${CSP_EXTRA_WS_ORIGIN_2}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    location = /healthz { access_log off; return 200 "ok\n"; }

    # Метки относятся к текущему неизменяемому артефакту, а не к кешу браузера.
    location = /version.json { try_files $uri =404; expires -1; }

    # Авторизованная загрузка вложений: API ограничивает размер до 10 МиБ и проверяет содержимое.
    # Данные передаются напрямую, без сохранения приватных файлов во временном каталоге прокси.
    location ~ ^/api/v1/conferences/[^/]+/attachments/[^/]+/content$ {
        client_max_body_size 11m;
        client_body_timeout 60s;
        proxy_request_buffering off;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    location = /api/v1/notifications/events {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 40s;
    }

    # Журнал ошибок вышестоящего сервера может раскрыть параметр ticket в строке запроса.
    location ~ ^/api/v1/conferences/[^/]+/ws$ {
        error_log /dev/null crit;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location /api/ {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
        proxy_hide_header Access-Control-Allow-Origin;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }
    location /media/ { try_files $uri =404; expires 1d; }
    # Секретные параметры OAuth не нужны для выдачи SPA и не должны попадать в журнал ошибок.
    location ~ ^/app/settings/calendar/[^/]+/callback$ {
        error_log /dev/null crit;
        try_files /index.html =404;
        expires -1;
    }
    location / { try_files $uri $uri/ /index.html; }
    location = /index.html { expires -1; }
}
