map $http_upgrade $connection_upgrade { default upgrade; '' close; }
log_format safe_realtime '$remote_addr $request_method $uri $status';
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 1m;
    access_log /var/log/nginx/access.log safe_realtime;

    # Docker DNS re-resolves the API after its container is recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream "${API_UPSTREAM}";
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; font-src 'self'; connect-src 'self' ws://$http_host wss://$http_host; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    location = /healthz { access_log off; return 200 "ok\n"; }

    # Authenticated attachment upload: API enforces the exact 10 MiB/content
    # limit. Stream directly instead of spooling private files in proxy temp.
    location ~ ^/api/v1/conferences/[^/]+/attachments/[^/]+/content$ {
        client_max_body_size 11m;
        client_body_timeout 60s;
        proxy_request_buffering off;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    location = /api/v1/notifications/events {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 40s;
    }

    # Upstream error logs may otherwise include the ticket query string.
    location ~ ^/api/v1/conferences/[^/]+/ws$ {
        error_log /dev/null crit;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location /api/ {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
        proxy_hide_header Access-Control-Allow-Origin;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }
    location /media/ { try_files $uri =404; expires 1d; }
    location / { try_files $uri $uri/ /index.html; }
    location = /index.html { expires -1; }
}
