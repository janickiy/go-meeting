APP_ENV=local
APP_PORT=8085
APP_HOST_PORT=8085
HTTPS_HOST_PORT=18482
FRONTEND_HOST_PORT=5173
GIN_MODE=debug
# Required by API only, at least 32 random bytes; no default secret.
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Empty: do not trust forwarded client IP headers. Set only actual proxy CIDRs/IPs.
HTTP_TRUSTED_PROXIES=
DLV_API_PORT=2345
DLV_WORKER_PORT=2346
WORKER_ID=recorder-worker-local
WORKER_PORT=8090
WORKER_HOST_PORT=8090
WORKER_INTERNAL_URL=http://host.docker.internal:18080/api/v1/record-worker
STORAGE_PATH=/storage
FFMPEG_PATH=ffmpeg
WEBRTC_UDP_PORT=50000
WEBRTC_TCP_PORT=50000
# Firefox requires the host LAN IP here; it rejects loopback ICE candidates.
WEBRTC_NAT_IPS=127.0.0.1

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_DB=go_recorder
POSTGRES_USER=go_recorder
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
RECORD_LOCK_TTL=6h

# Stage 2: same namespace on all API instances sharing this PostgreSQL database.
WS_REDIS_NAMESPACE=go-recorder:realtime:v1
WS_PING_INTERVAL=25s
WS_PONG_TIMEOUT=10s
WS_WRITE_TIMEOUT=5s
WS_SESSION_TTL=75s
WS_TICKET_TTL=45s
WS_QUEUE_SIZE=64
WS_MAX_MESSAGE_BYTES=65536
WS_MAX_OUTBOUND_BYTES=262144
WS_MAX_SDP_BYTES=49152
WS_MAX_ICE_BYTES=4096
WS_MESSAGES_PER_SECOND=20
WS_MESSAGE_BURST=40
# Empty: require the exact same host + port as the WebSocket HTTP request.
WS_ALLOWED_ORIGINS=
# Authenticated browser config; no built-in public STUN or production TURN secret.
WEBRTC_ICE_SERVERS_JSON=[]

# Stage 3 SFU: independent of recorder-worker. Generate dedicated keys for production.
# In local/dev only, blank keys are domain-separated derivatives of JWT_SECRET.
MEDIA_TICKET_SECRET=
MEDIA_INTERNAL_SECRET=
MEDIA_HTTP_PORT=8091
MEDIA_WORKER_ID=media-worker-local
MEDIA_WORKER_INTERNAL_URL=http://media-worker:8091
MEDIA_REDIS_NAMESPACE=go-recorder:media:v1
MEDIA_TICKET_TTL=45s
MEDIA_OPERATION_TIMEOUT=5s
MEDIA_HEARTBEAT_INTERVAL=5s
MEDIA_WORKER_TTL=15s
MEDIA_OWNERSHIP_TTL=20s
MEDIA_SESSION_CHECK_INTERVAL=5s
MEDIA_MAX_PEERS=10
MEDIA_MAX_ROOMS=100
MEDIA_MAX_PUBLISHED_TRACKS=4
MEDIA_MAX_AUDIO_TRACKS=2
MEDIA_MAX_VIDEO_TRACKS=2
MEDIA_MAX_SCREEN_SHARERS=1
MEDIA_EGRESS_QUEUE_SIZE=2048
MEDIA_VIDEO_MAX_WIDTH=1280
MEDIA_VIDEO_MAX_HEIGHT=720
MEDIA_VIDEO_MAX_FPS=30
# UDP mux or a dedicated UDP range, never both. Compose uses the mux by default.
MEDIA_UDP_PORT=50010
MEDIA_UDP_MIN_PORT=0
MEDIA_UDP_MAX_PORT=0
MEDIA_TCP_PORT=50010
# Set your host LAN IP for Firefox and Docker Desktop; use a reachable public IP on a server.
MEDIA_NAT_IPS=127.0.0.1
MEDIA_ICE_SERVERS_JSON=[]
MEDIA_ICE_DISCONNECTED_TIMEOUT=10s
MEDIA_ICE_FAILED_TIMEOUT=20s
MEDIA_ICE_KEEPALIVE_INTERVAL=2s
MEDIA_NEGOTIATION_TIMEOUT=10s

# Stage 4: FFmpeg runs only in recorder-worker; bounds apply per worker.
RECORDING_WIDTH=1280
RECORDING_HEIGHT=720
RECORDING_FPS=30
RECORDING_FFMPEG_CONCURRENCY=1
RECORDING_MAX_ACTIVE=2
# Received RTP per recording, not a filesystem quota for spool/composite files.
RECORDING_MAX_MIB=10240
RECORDING_LEASE_TTL=20s
RECORDING_POLL_INTERVAL=1s
RECORDING_MAX_DURATION=4h
# Successful local spools are removed after private MinIO artifacts are committed.
RECORDING_KEEP_LOCAL=false

RABBIT_MQ_USER=go_recorder
RABBIT_MQ_PASSWORD=
RABBIT_MQ_HOST=rabbitmq
RABBIT_MQ_PORT=5672
RABBIT_MQ_HOST_PORT=5672
RABBIT_MQ_MANAGEMENT_HOST_PORT=15672
RABBIT_MQ_VHOST=/
RABBIT_MQ_EXCHANGE=go-recorder.commands
RABBIT_MQ_QUEUE=go-recorder.recording.commands
RABBIT_MQ_ROUTING_KEY=record.commands

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_DEFAULT_RPM=240
RATE_LIMIT_AUTH_LOGIN_IP_RPM=10
RATE_LIMIT_AUTH_REGISTER_IP_RPM=5
RATE_LIMIT_RECORD_START_CONFERENCE_RPM=12
RATE_LIMIT_RECORD_START_IP_RPM=40
RATE_LIMIT_RECORD_END_RECORD_RPM=40
RATE_LIMIT_RECORD_END_IP_RPM=120
RATE_LIMIT_WEBRTC_OFFER_RECORD_RPM=40
RATE_LIMIT_WEBRTC_OFFER_IP_RPM=120
RATE_LIMIT_RECORD_LIST_IP_RPM=240
RATE_LIMIT_RECORD_READ_IP_RPM=480

MINIO_ROOT_USER=go_recorder
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=https://localhost:18482
MINIO_PORT_HOST=9000
MINIO_CONSOLE_PORT_HOST=9001
MINIO_BUCKET=recordings
MINIO_USE_SSL=false

# Этап 6: эксплуатация. Пустые secrets требуется заполнить перед запуском prod.
WORKER_INTERNAL_SECRET=
METRICS_SECRET=
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL=10m
TURN_FORCE_RELAY=false
WS_MAX_CONNECTIONS=1000
HTTP_MAX_BODY_BYTES=1048576
HTTP_READ_TIMEOUT=60s
HEALTH_PROBE_INTERVAL=2s
HEALTH_PROBE_TIMEOUT=1s
SHUTDOWN_TIMEOUT=20s
DB_MAX_OPEN=20
DB_MAX_IDLE=10
DB_CONNECTION_LIFETIME=30m
DB_QUERY_TIMEOUT=10s
RECORDING_DISK_RESERVE_MIB=256
# Только loopback внутри контейнера; 0 отключает pprof.
PPROF_PORT=0
